NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server-only. Nunca usar con prefijo NEXT_PUBLIC_ ni exponer al navegador.
# Requerida para administracion interna de usuarios y auditoria controlada.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Sal aleatoria de al menos 32 caracteres para anonimizar IP e idempotencia.
# Generar una distinta por entorno. Nunca usar prefijo NEXT_PUBLIC_.
ORDER_RATE_LIMIT_SALT=

# Server-only. Mantener false fuera de una ventana QA autorizada.
ALLOW_TEST_DATA_RESET=false
